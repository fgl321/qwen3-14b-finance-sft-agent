# Application
APP_NAME=qwen3-14b-bf16-finance-agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8002

# DeepSeek（不要把真实密钥提交到 GitHub）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=120
HTTP_TRUST_ENV=false

# Self-hosted Qwen3-14B + final SFT LoRA/tokenizer/embedding patch.
# This endpoint must be started by the downloader on their own GPU.
QWEN_API_KEY=local-qwen
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_MODEL=qwen3-14b-bf16-finance-sft
QWEN_CONNECT_TIMEOUT=15
QWEN_READ_TIMEOUT=180

# 最终回答生成模型：qwen=本地蒸馏模型（默认），deepseek=DeepSeek API。
# 全链路验证阶段可临时设为 deepseek，验证通过后切回 qwen。
SYNTHESIS_LLM_PROVIDER=qwen

# PostgreSQL
POSTGRES_DSN=postgresql://agent:agent@127.0.0.1:5432/agent
POSTGRES_PASSWORD=agent

# Redis short memory
REDIS_URL=redis://127.0.0.1:6379/0
SHORT_MEMORY_ENABLED=true
SHORT_MEMORY_MAX_MESSAGES=12
SHORT_MEMORY_TTL_SECONDS=86400

# Qdrant / RAG
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=finance_knowledge
RAG_DENSE_VECTOR_NAME=dense
RAG_SPARSE_VECTOR_NAME=sparse
RAG_DENSE_VECTOR_SIZE=1024

# RAG 检索参数
RAG_CHILD_LIMIT=8
RAG_PARENT_LIMIT=4
# 展示分（0~100）低于该阈值的证据会被过滤，0 表示不过滤。
RAG_MIN_SCORE=0

# Rerank（BGE-Reranker，模型加载失败自动降级为不重排）
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_PROVIDER=local
RAG_RERANK_HTTP_URL=
RAG_RERANK_TOP_K=6
RAG_RERANK_BATCH_SIZE=8
RAG_RERANK_DEVICE=
RAG_RERANK_USE_FP16=true

# 多轮查询改写（只影响检索，不影响最终回答）
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MAX_TOKENS=256

# Embedding
EMBEDDING_PROVIDER=bge-m3
# 使用远程 GPU embedding 服务时改为 http，并填写地址（见 scripts/slurm/gpu_embed_server.sbatch）
EMBEDDING_HTTP_URL=
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_USE_FP16=true
BGE_M3_BATCH_SIZE=4
BGE_M3_MAX_LENGTH=8192
BGE_M3_DEVICE=
