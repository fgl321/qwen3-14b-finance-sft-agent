# Application
APP_NAME=qwen3-14b-bf16-finance-agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8002

# DeepSeek（不要把真实密钥提交到 GitHub）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=120
HTTP_TRUST_ENV=false

# Self-hosted Qwen3-14B + final SFT LoRA/tokenizer/embedding patch.
# This endpoint must be started by the downloader on their own GPU.
QWEN_API_KEY=local-qwen
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_MODEL=qwen3-14b-bf16-finance-sft
QWEN_CONNECT_TIMEOUT=15
QWEN_READ_TIMEOUT=180

# PostgreSQL
POSTGRES_DSN=postgresql://agent:agent@127.0.0.1:5432/agent
POSTGRES_PASSWORD=agent

# Redis short memory
REDIS_URL=redis://127.0.0.1:6379/0
SHORT_MEMORY_ENABLED=true
SHORT_MEMORY_MAX_MESSAGES=12
SHORT_MEMORY_TTL_SECONDS=86400

# Qdrant / RAG
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=finance_knowledge
RAG_DENSE_VECTOR_NAME=dense
RAG_SPARSE_VECTOR_NAME=sparse
RAG_DENSE_VECTOR_SIZE=1024

# Embedding
EMBEDDING_PROVIDER=bge-m3
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_USE_FP16=true
BGE_M3_BATCH_SIZE=4
BGE_M3_MAX_LENGTH=8192
BGE_M3_DEVICE=
