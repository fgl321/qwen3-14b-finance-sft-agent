# Application
APP_NAME=qwen3-14b-bf16-finance-agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8002
CONTROL_PLANE_SHADOW_ENABLED=false
CONTROL_PLANE_SHADOW_SAMPLE_RATE=0.0
CONTROL_PLANE_FAULT_INJECTION_ENABLED=false
CONTROL_PLANE_V2_EXECUTION_ENABLED=false
SINGLE_USER_MODE=true
PERSONAL_TENANT_ID=personal
PERSONAL_USER_ID=owner
MAX_HTTP_BODY_BYTES=67108864
MAX_UPLOAD_BYTES=52428800
PRODUCTION_MAX_AGENT_ROUNDS=3
PRODUCTION_MAX_TOTAL_TOOL_CALLS=6
PRODUCTION_MAX_PARALLEL_TOOL_CALLS=4
PRODUCTION_MAX_PLAN_REPAIRS_PER_EXECUTION_ROUND=4
# 仅供旧版聚合 AgentToolLoop 兼容；显式生产工作流不使用它计算执行轮数。
PRODUCTION_MAX_PLAN_REVISIONS=2
PRODUCTION_MAX_OUTPUT_REWRITES=2
PRODUCTION_TOTAL_TIMEOUT_SECONDS=120

# DeepSeek（不要把真实密钥提交到 GitHub）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=120
HTTP_TRUST_ENV=false

# Self-hosted Qwen3-14B + final SFT LoRA/tokenizer/embedding patch.
# This endpoint must be started by the downloader on their own GPU.
QWEN_API_KEY=local-qwen
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_MODEL=qwen3-14b-bf16-finance-sft
QWEN_CONNECT_TIMEOUT=15
QWEN_READ_TIMEOUT=180

# 最终回答生成模型：qwen=本地蒸馏模型（默认），deepseek=DeepSeek API。
# 全链路验证阶段可临时设为 deepseek，验证通过后切回 qwen。
SYNTHESIS_LLM_PROVIDER=qwen

# PostgreSQL
POSTGRES_DSN=postgresql://agent:agent@127.0.0.1:5432/agent
POSTGRES_PASSWORD=agent

# Redis short memory
REDIS_URL=redis://127.0.0.1:6379/0
SHORT_MEMORY_ENABLED=true
SHORT_MEMORY_MAX_MESSAGES=12
SHORT_MEMORY_TTL_SECONDS=86400

# Qdrant / RAG
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=finance_knowledge
RAG_DENSE_VECTOR_NAME=dense
RAG_SPARSE_VECTOR_NAME=sparse
RAG_DENSE_VECTOR_SIZE=1024

# RAG 检索参数
RAG_CHILD_LIMIT=8
RAG_PARENT_LIMIT=4
# 展示分（0~100）低于该阈值的证据会被过滤，0 表示不过滤。
RAG_MIN_SCORE=0

# Rerank（BGE-Reranker，模型加载失败自动降级为不重排）
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_PROVIDER=local
RAG_RERANK_HTTP_URL=
RAG_RERANK_TOP_K=6
RAG_RERANK_BATCH_SIZE=8
RAG_RERANK_DEVICE=
RAG_RERANK_USE_FP16=true

# 多轮查询改写（只影响检索，不影响最终回答）
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MAX_TOKENS=256

# Embedding
EMBEDDING_PROVIDER=bge-m3
# 使用远程 GPU embedding 服务时改为 http，并填写地址（见 scripts/slurm/gpu_embed_server.sbatch）
EMBEDDING_HTTP_URL=
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_USE_FP16=true
BGE_M3_BATCH_SIZE=16
BGE_M3_MAX_LENGTH=1024
BGE_M3_DEVICE=
RAG_INGEST_EMBEDDING_BATCH_SIZE=128
RAG_QDRANT_UPSERT_BATCH_SIZE=128
